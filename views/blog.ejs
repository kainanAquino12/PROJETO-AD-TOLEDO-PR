<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= c.blog.titulo || 'Blog' %> — <%= c.site.nome %></title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%23162f4a%27/%3E%3Ctext x=%2716%27 y=%2722.5%27 font-family=%27Arial,sans-serif%27 font-weight=%27700%27 font-size=%2717%27 text-anchor=%27middle%27 fill=%27%23c6a052%27%3EE%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Mulish:wght@300;400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%
    var fmtData = function (d) {
      var t = new Date(String(d || '').slice(0, 10) + 'T12:00:00');
      return isNaN(t) ? '' : t.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
    };
  %>
  <%- include('partials/header', { base: '/', ativo: '/blog' }) %>

  <main class="section blog-page">
    <div class="container">
      <header class="section__head section__head--center">
        <h1 class="title"><%= c.blog.titulo || 'Blog' %></h1>
        <% if (c.blog.subtitulo) { %><p class="lead"><%= c.blog.subtitulo %></p><% } %>
      </header>

      <% if (posts.length) { %>
        <div class="bgrid">
          <% posts.forEach(function (p) { %>
            <a class="bcard" href="/blog/<%= encodeURIComponent(p.id) %>">
              <span class="bcard__img">
                <% if (p.imagem) { %>
                  <% var bSrcset = srcset(p.imagem); %>
                  <img src="<%= p.imagem %>" alt="<%= p.titulo %>" loading="lazy"
                       <% if (bSrcset) { %>srcset="<%= bSrcset %>" sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 360px"<% } %> />
                <% } else { %>
                  <span class="bcard__ph" aria-hidden="true"><%- include('partials/icon', { name: 'quote', cls: '' }) %></span>
                <% } %>
              </span>
              <span class="bcard__body">
                <% if (fmtData(p.data)) { %><time class="bcard__date" datetime="<%= String(p.data).slice(0, 10) %>"><%= fmtData(p.data) %></time><% } %>
                <span class="bcard__title"><%= p.titulo %></span>
                <% if (p.resumo) { %><span class="bcard__text"><%= p.resumo %></span><% } %>
                <span class="link-arrow">Ler artigo</span>
              </span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="lead" style="text-align:center;margin:0 auto">Em breve publicaremos nossos primeiros artigos.</p>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
