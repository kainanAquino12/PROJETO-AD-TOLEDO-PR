<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= c.site.nome %> — <%= c.site.cidade %></title>
  <meta name="description" content="<%= c.hero.paragrafos[0] || c.site.nome %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Mulish:wght@300;400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <%- include('partials/header', { base: '' }) %>

  <main>

  <!-- ====================== INÍCIO ====================== -->
  <section class="hero" id="inicio">
    <div class="container hero__grid">
      <div class="hero__text">
        <% if (c.hero.eyebrow) { %><span class="eyebrow"><%= c.hero.eyebrow %></span><% } %>
        <h1 class="hero__title">
          <%= c.hero.titulo1 %>
          <span><%= c.hero.titulo2 %></span>
        </h1>
        <% (c.hero.paragrafos || []).slice(0, 1).forEach(function(p){ %><p class="hero__lead"><%= p %></p><% }); %>

        <%
          /* um unico botao: entrar no grupo; sem link configurado cai no botao do hero */
          var linkParticipar = c.config.whatsapp_grupo || c.hero.botao2_link || c.hero.botao1_link || '#rodape';
          var textoParticipar = c.hero.botao2_texto || c.hero.botao1_texto;
        %>
        <% if (textoParticipar) { %>
          <a href="<%= linkParticipar %>" class="btn btn--navy"<% if (/^https?:/.test(linkParticipar)) { %> target="_blank" rel="noopener"<% } %>><%= textoParticipar %></a>
        <% } %>
      </div>
    </div>

    <% if (c.hero.imagem) { %>
      <% var hSrcset = srcset(c.hero.imagem); %>
      <figure class="hero__photo">
        <img src="<%= c.hero.imagem %>" alt="Encontro do <%= c.site.nome %>"
             <% if (hSrcset) { %>srcset="<%= hSrcset %>" sizes="(max-width: 860px) 100vw, 60vw"<% } %>
             style="--zoom: <%= (Number(c.hero.imagem_zoom) || 100) / 100 %>" />
      </figure>
    <% } %>
  </section>

  <!-- ====================== NÚMEROS ====================== -->
  <% if (c.numeros && c.numeros.itens && c.numeros.itens.length) { %>
    <section class="stats">
      <div class="container stats__grid">
        <% c.numeros.itens.forEach(function(n){ %>
          <div class="stat">
            <strong class="stat__value"><%= n.valor %></strong>
            <% if (n.texto) { %><span class="stat__label"><%= n.texto %></span><% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- ====================== SOBRE NÓS ====================== -->
  <section class="section sobre" id="sobre">
    <div class="container sobre__grid">
      <div class="sobre__head">
        <h2 class="title"><%= c.sobre.titulo %></h2>
        <% if (c.sobre.intro) { %><p class="sobre__intro"><%= c.sobre.intro %></p><% } %>
        <% if (c.sobre.insta_titulo && c.footer.instagram && c.footer.instagram !== '#') { %>
          <a href="<%= c.footer.instagram %>" target="_blank" rel="noopener" class="link-arrow"><%= c.sobre.insta_botao || 'Conheça no Instagram' %></a>
        <% } %>
      </div>
      <% if (c.sobre.itens && c.sobre.itens.length) { %>
        <div class="sobre__itens">
          <% c.sobre.itens.forEach(function(it){ %>
            <div class="sitem">
              <h3 class="sitem__title"><%= it.titulo %></h3>
              <p><%= it.texto %></p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- ====================== EMPRESAS PARCEIRAS (a lista fica em /parceiras) ====================== -->
  <section class="section section--soft partners" id="parceiras">
    <div class="container partners__inner">
      <div>
        <h2 class="title"><%= c.parceiras.titulo %></h2>
        <% if (c.parceiras.texto) { %><p class="lead"><%= c.parceiras.texto %></p><% } %>
      </div>
      <a href="/parceiras" class="btn btn--outline"><%= c.parceiras.botao_texto || 'Ver empresas parceiras' %></a>
    </div>
  </section>

  <!-- ====================== ENCONTROS ====================== -->
  <%
    var MESES = ['', 'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
    var cards = c.encontros.cards || [];
    var g = c.encontros.galeria || {};
    var albuns = (c.encontros.albuns || []).filter(function (a) { return a.fotos && a.fotos.length; })
      .sort(function (a, b) { return (Number(b.ano) * 12 + Number(b.mes)) - (Number(a.ano) * 12 + Number(a.mes)); });
    /* sem albuns por mes, as fotos soltas da galeria continuam aparecendo */
    var soltas = albuns.length ? [] : (g.fotos || []);
  %>
  <section class="section" id="encontros">
    <div class="container">
      <header class="section__head">
        <h2 class="title"><%= c.encontros.titulo %></h2>
        <% if (c.encontros.subtitulo) { %><p class="lead"><%= c.encontros.subtitulo %></p><% } %>
      </header>

      <%
        /* destaque grande (primeiro encontro) + 4 fotos menores. As menores saem dos
           demais encontros e, se faltar, das fotos da galeria. */
        var destaque = cards[0];
        var menores = cards.slice(1).filter(function (k) { return k.foto; })
          .map(function (k) { return { foto: k.foto, zoom: k.zoom, alt: k.titulo || k.data || 'Foto do encontro' }; });
        var pool = (g.fotos || []).concat.apply([], albuns.map(function (al) { return al.fotos; }));
        pool.forEach(function (f) {
          if (menores.length < 4 && f && menores.every(function (m) { return m.foto !== f; }) && (!destaque || destaque.foto !== f)) {
            menores.push({ foto: f, zoom: 100, alt: 'Foto do encontro' });
          }
        });
        menores = menores.slice(0, 4);
        var dMeta = destaque ? [destaque.data, destaque.local, destaque.publico].filter(Boolean) : [];
      %>
      <% if (destaque) { %>
        <div class="elayout">
          <article class="efeature">
            <% if (destaque.foto) { %>
              <% var dSrcset = srcset(destaque.foto), dZoom = (Number(destaque.zoom) || 100) / 100; %>
              <a href="<%= destaque.foto %>" class="efeature__photo" data-lightbox>
                <img src="<%= destaque.foto %>" alt="<%= destaque.titulo || 'Foto do encontro' %>" decoding="async"
                     <% if (dSrcset) { %>srcset="<%= dSrcset %>" sizes="(max-width: 980px) 92vw, 640px"<% } %>
                     style="--zoom: <%= dZoom %>" />
              </a>
            <% } %>
            <% if (destaque.selo || destaque.badge || destaque.titulo || dMeta.length || destaque.botao_texto) { %>
              <div class="ecard__caption">
                <% if (destaque.selo || destaque.badge) { %><span class="ecard__tag"><%= [destaque.selo, destaque.badge].filter(Boolean).join(' · ') %></span><% } %>
                <% if (destaque.titulo) { %><h3 class="ecard__title"><%= destaque.titulo %></h3><% } %>
                <% if (dMeta.length) { %><p class="ecard__meta"><%= dMeta.join(' · ') %></p><% } %>
                <% if (destaque.botao_texto && destaque.botao_link && destaque.botao_link !== '#') { %><a href="<%= destaque.botao_link %>" class="link-arrow"><%= destaque.botao_texto %></a><% } %>
              </div>
            <% } %>
          </article>

          <% if (menores.length) { %>
            <div class="esmall">
              <% menores.forEach(function (m) { var ms = srcset(m.foto); %>
                <a href="<%= m.foto %>" class="esmall__photo" data-lightbox title="<%= m.alt %>">
                  <img src="<%= m.foto %>" alt="<%= m.alt %>" decoding="async"
                       <% if (ms) { %>srcset="<%= ms %>" sizes="(max-width: 980px) 46vw, 260px"<% } %>
                       style="--zoom: <%= (Number(m.zoom) || 100) / 100 %>" />
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (albuns.length || soltas.length) { %>
        <div class="galeria" id="galeria">
          <% albuns.forEach(function (a) { %>
            <div class="album">
              <h3 class="album__title">Encontro de <%= MESES[Number(a.mes)] || '' %> <%= a.ano %></h3>
              <div class="album__grid">
                <% a.fotos.forEach(function (foto) { var gs = srcset(foto); %>
                  <a href="<%= foto %>" class="album__foto" data-lightbox>
                    <img src="<%= foto %>" alt="Encontro de <%= MESES[Number(a.mes)] || '' %> <%= a.ano %>" loading="lazy"
                         <% if (gs) { %>srcset="<%= gs %>" sizes="(max-width: 560px) 46vw, 200px"<% } %> />
                  </a>
                <% }); %>
              </div>
            </div>
          <% }); %>
          <% if (soltas.length) { %>
            <div class="album">
              <div class="album__grid">
                <% soltas.forEach(function (foto) { var gs = srcset(foto); %>
                  <a href="<%= foto %>" class="album__foto" data-lightbox>
                    <img src="<%= foto %>" alt="Foto do encontro" loading="lazy"
                         <% if (gs) { %>srcset="<%= gs %>" sizes="(max-width: 560px) 46vw, 200px"<% } %> />
                  </a>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (c.encontros.botao_texto && c.encontros.botao_link && c.encontros.botao_link !== '#') { %>
        <p class="section__more"><a href="<%= c.encontros.botao_link %>" class="link-arrow"><%= c.encontros.botao_texto %></a></p>
      <% } %>
    </div>
  </section>

  <!-- ====================== DIRETORIA ====================== -->
  <section class="section section--soft" id="diretoria">
    <div class="container">
      <header class="section__head section__head--center">
        <% if (c.diretoria.eyebrow) { %><span class="eyebrow"><%= c.diretoria.eyebrow %></span><% } %>
        <h2 class="title"><%= c.diretoria.titulo %></h2>
        <% if (c.diretoria.subtitulo) { %><p class="lead"><%= c.diretoria.subtitulo %></p><% } %>
      </header>

      <div class="team">
        <% (c.diretoria.membros || []).forEach(function(m){ %>
          <article class="member" data-membro tabindex="0" role="button" aria-label="Mais informações de <%= m.nome %>">
            <div class="member__photo">
              <% if (m.foto) { %>
                <% var mZoom = (Number(m.zoom) || 100) / 100, mSrcset = srcset(m.foto); %>
                <img src="<%= m.foto %>" alt="<%= m.nome %>" loading="lazy"
                     <% if (mSrcset) { %>srcset="<%= mSrcset %>" sizes="(max-width: 560px) 46vw, 300px"<% } %>
                     style="--zoom: <%= mZoom %>" />
              <% } else { %>
                <%- include('partials/icon', { name: 'user', cls: 'member__ph' }) %>
              <% } %>
            </div>
            <h3 class="member__name"><%= m.nome %></h3>
            <% if (m.cargo) { %><span class="member__role"><%= m.cargo %></span><% } %>

            <%- /* conteudo completo, copiado para a janela ao clicar */ '' %>
            <div class="member__full" hidden>
              <h3 class="member__name"><%= m.nome %></h3>
              <% if (m.cargo) { %><span class="member__role"><%= m.cargo %></span><% } %>
              <% if (m.descricao) { %><p class="member__bio"><%= m.descricao %></p><% } %>
              <% if (m.email || m.linkedin || m.instagram) { %>
                <p class="member__links">
                  <% if (m.instagram) { %><a href="<%= m.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
                  <% if (m.linkedin) { %><a href="<%= m.linkedin %>" target="_blank" rel="noopener">LinkedIn</a><% } %>
                  <% if (m.email) { %><a href="mailto:<%= m.email %>">E-mail</a><% } %>
                </p>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <div class="modal" id="membroModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal__box">
      <button type="button" class="modal__close" data-membro-close aria-label="Fechar">&times;</button>
      <div id="membroConteudo"></div>
    </div>
  </div>

  <!-- ====================== PALAVRA PASTORAL ====================== -->
  <%
    /* a carta chega do painel como texto corrido; blocos() separa paragrafos,
       lista de marcadores e versiculo -- ver blocosDeTexto() no server.js */
    var carta = blocos(c.hero.pastoral_carta);
    var valores = c.hero.pastoral_valores || [];
    var temAutor = c.hero.pastoral_autor || c.hero.pastoral_autor_cargo;
  %>
  <% if (c.hero.pastoral_titulo || c.hero.pastoral_texto || carta.length) { %>
    <section class="section pastoral" id="pastoral">
      <div class="container">
        <div class="pastoral__grid<%= c.hero.pastoral_foto ? '' : ' pastoral__grid--solo' %>">
          <div class="pastoral__head">
            <% if (c.hero.pastoral_titulo) { %><span class="eyebrow"><%= c.hero.pastoral_titulo %></span><% } %>
            <% if (c.hero.pastoral_texto) { %><h2 class="pastoral__lead"><%= c.hero.pastoral_texto %></h2><% } %>
          </div>

          <% if (c.hero.pastoral_foto) { %>
            <%
              var pfZoom = (Number(c.hero.pastoral_foto_zoom) || 100) / 100;
              var pfSrcset = srcset(c.hero.pastoral_foto);
            %>
            <figure class="pastoral__photo">
              <img src="<%= c.hero.pastoral_foto %>"
                   <% if (pfSrcset) { %>srcset="<%= pfSrcset %>" sizes="(max-width: 860px) 70vw, 380px"<% } %>
                   alt="<%= c.hero.pastoral_autor || c.hero.pastoral_titulo %>" loading="lazy"
                   <% if (pfZoom !== 1) { %>class="is-zoomed" style="--zoom: <%= pfZoom %>"<% } %> />
            </figure>
          <% } %>

          <div class="pastoral__body">
            <% carta.forEach(function (b) { %>
              <% if (b.tipo === 'lista') { %>
                <ul class="pastoral__list">
                  <% b.itens.forEach(function (item) { %><li><%= item %></li><% }); %>
                </ul>
              <% } else { %>
                <p class="pastoral__p<%= b.tipo === 'versiculo' ? ' pastoral__p--verso' : '' %>"><%= b.texto %></p>
              <% } %>
            <% }); %>

            <% if (c.hero.pastoral_verso) { %>
              <p class="pastoral__verse"><%= c.hero.pastoral_verso %><% if (c.hero.pastoral_verso_ref) { %> <span>— <%= c.hero.pastoral_verso_ref %></span><% } %></p>
            <% } %>

            <% if (temAutor) { %>
              <div class="pastoral__author">
                <% if (c.hero.pastoral_autor) { %><strong><%= c.hero.pastoral_autor %></strong><% } %>
                <% if (c.hero.pastoral_autor_cargo) { %><span><%= c.hero.pastoral_autor_cargo %></span><% } %>
              </div>
            <% } %>
          </div>
        </div>

        <% if (valores.length) { %>
          <ul class="pvalores">
            <% valores.forEach(function (v) { %>
              <li class="pvalor">
                <% if (v.titulo) { %><h3 class="pvalor__title"><%= v.titulo %></h3><% } %>
                <% if (v.texto) { %><p><%= v.texto %></p><% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ====================== PILARES ====================== -->
  <section class="section section--soft pilares">
    <div class="container">
      <h2 class="title title--center"><%= c.pilares.titulo %></h2>
      <div class="pilares__grid">
        <% c.pilares.itens.forEach(function(item){ %>
          <div class="pilar">
            <h3 class="pilar__title"><%= item.titulo %></h3>
            <p><%= item.descricao %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  </main>

  <%- include('partials/footer') %>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__close" id="lightboxClose" aria-label="Fechar">&times;</button>
    <img src="" alt="" id="lightboxImg" />
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
