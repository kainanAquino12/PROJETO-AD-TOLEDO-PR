<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel — Empreendedores do Reino</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%23162f4a%27/%3E%3Ctext x=%2716%27 y=%2722.5%27 font-family=%27Arial,sans-serif%27 font-weight=%27700%27 font-size=%2717%27 text-anchor=%27middle%27 fill=%27%23c6a052%27%3EE%3C/text%3E%3C/svg%3E" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Mulish:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="login-body">
  <div class="login-card">
    <div class="login-card__logo">
      <%- include('partials/logo', { cls: 'erlogo--login', cidade: 'TOLEDO/PR' }) %>
    </div>
    <h1 class="login-card__title">Painel Administrativo</h1>
    <p class="login-card__sub">Empreendedores do Reino</p>

    <% if (erro) { %>
      <div class="login-card__error"><%= erro %></div>
    <% } %>

    <form method="POST" action="/admin/login" class="login-form">
      <label for="senha">Senha de acesso</label>
      <input type="password" id="senha" name="senha" placeholder="Digite a senha" required autofocus />
      <button type="submit" class="btn-admin btn-admin--gold btn-admin--block">Entrar</button>
    </form>

    <a href="/" class="login-card__back">← Voltar ao site</a>
  </div>
</body>
</html>
