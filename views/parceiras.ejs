<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= c.parceiras.titulo %> — <%= c.site.nome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Mulish:wght@300;400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%
    /* as empresas entram por categoria (campo "segmento") e em ordem alfabetica
       dentro dela, para nenhuma ganhar mais destaque que outra */
    var porNome = function (a, b) { return String(a).trim().localeCompare(String(b).trim(), 'pt-BR', { sensitivity: 'base' }); };
    var grupos = {};
    (c.parceiras.lista || []).forEach(function (p) {
      var cat = (p.segmento || '').trim() || 'Outras';
      (grupos[cat] = grupos[cat] || []).push(p);
    });
    var cats = Object.keys(grupos).sort(function (a, b) {
      if (a === 'Outras') return 1; if (b === 'Outras') return -1; return porNome(a, b);
    });
    /* icone da categoria, escolhido pelo nome (sem acento); categorias novas caem no generico */
    function iconeDa(cat) {
      var n = String(cat).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      if (/gas|energia|combust/.test(n)) return 'flame';
      if (/imobili|construc|engenharia/.test(n)) return 'home';
      if (/transport|logistic|van|veicul|auto/.test(n)) return 'truck';
      if (/supermerc|mercado|aliment/.test(n)) return 'cart';
      if (/varejo|comerc|loja|moda/.test(n)) return 'bag';
      return 'briefcase';
    }
  %>
  <%- include('partials/header', { base: '/' }) %>

  <main class="section partners-page">
    <div class="container">
      <header class="section__head">
        <h1 class="title"><%= c.parceiras.titulo %></h1>
        <% if (c.parceiras.texto) { %><p class="lead"><%= c.parceiras.texto %></p><% } %>
      </header>

      <% if (cats.length) { %>
        <div class="pfilters" role="tablist" aria-label="Categorias">
          <button type="button" class="pfilter is-active" data-cat="">Todas</button>
          <% cats.forEach(function (cat) { %><button type="button" class="pfilter" data-cat="<%= cat %>"><%= cat %></button><% }); %>
        </div>

        <div class="pcols">
          <% cats.forEach(function (cat) { %>
            <div class="pgroup" data-cat="<%= cat %>">
              <h2 class="pgroup__title"><%- include('partials/icon', { name: iconeDa(cat), cls: 'pgroup__icon' }) %><span><%= cat %></span></h2>
              <div class="plist">
                <% grupos[cat].sort(function (a, b) { return porNome(a.nome, b.nome); }).forEach(function (p) {
                     var hasLink = p.link && p.link !== '#'; %>
                  <a class="pitem<%= hasLink ? '' : ' pitem--nolink' %>"<% if (hasLink) { %> href="<%= p.link %>" target="_blank" rel="noopener"<% } %> title="<%= p.nome %>">
                    <span class="pitem__logo">
                      <% if (p.logo) { %>
                        <% var pZoom = (Number(p.zoom) || 108) / 100, pSrcset = srcset(p.logo); %>
                        <img src="<%= p.logo %>" alt="<%= p.nome %>" loading="lazy"
                             <% if (pSrcset) { %>srcset="<%= pSrcset %>" sizes="(max-width: 560px) 80vw, 300px"<% } %>
                             style="--zoom: <%= pZoom %>" />
                      <% } else { %>
                        <span class="pitem__fallback"><%= p.nome %></span>
                      <% } %>
                    </span>
                    <span class="pitem__name"><%= p.nome %></span>
                  </a>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="lead">Em breve apresentaremos nossas empresas parceiras.</p>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    (function () {
      var botoes = document.querySelectorAll('.pfilter');
      var grupos = document.querySelectorAll('.pgroup');
      botoes.forEach(function (b) {
        b.addEventListener('click', function () {
          botoes.forEach(function (x) { x.classList.toggle('is-active', x === b); });
          grupos.forEach(function (g) { g.hidden = !!b.dataset.cat && g.dataset.cat !== b.dataset.cat; });
        });
      });
    })();
  </script>
</body>
</html>
