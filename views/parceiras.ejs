<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= c.parceiras.titulo %> — <%= c.site.nome %></title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%23162f4a%27/%3E%3Ctext x=%2716%27 y=%2722.5%27 font-family=%27Arial,sans-serif%27 font-weight=%27700%27 font-size=%2717%27 text-anchor=%27middle%27 fill=%27%23c6a052%27%3EE%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Mulish:wght@300;400;500;600&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%
    /* as empresas entram por categoria (campo "segmento") e em ordem alfabetica
       dentro dela, para nenhuma ganhar mais destaque que outra */
    var porNome = function (a, b) { return String(a).trim().localeCompare(String(b).trim(), 'pt-BR', { sensitivity: 'base' }); };
    /* a categoria e comparada sem acento, caixa ou espacos sobrando: "Imobiliaria " e
       "imobiliária" caem no mesmo grupo (vale o primeiro nome digitado) */
    var chave = function (t) { return String(t).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim(); };
    var grupos = {}, rotulos = {};
    (c.parceiras.lista || []).forEach(function (p) {
      var nome = (p.segmento || '').trim() || 'Outras';
      var k = chave(nome);
      if (!rotulos[k]) rotulos[k] = nome;
      (grupos[k] = grupos[k] || []).push(p);
    });
    var cats = Object.keys(grupos).sort(function (a, b) {
      if (a === 'outras') return 1; if (b === 'outras') return -1; return porNome(rotulos[a], rotulos[b]);
    });
    var todas = [];
    cats.forEach(function (k) { grupos[k].forEach(function (p) { todas.push(Object.assign({}, p, { cat: k })); }); });
    todas.sort(function (a, b) { return porNome(a.nome, b.nome); });
    /* empresas em destaque: marcadas no painel ("destaque"), na ordem escolhida;
       sem ordem, vao para o fim, em ordem alfabetica */
    var ordemDe = function (p) { var n = parseInt(p.destaque_ordem, 10); return n > 0 ? n : 1e9; };
    var destaques = (c.parceiras.lista || []).filter(function (p) { return p.destaque === true; })
      .sort(function (a, b) { return (ordemDe(a) - ordemDe(b)) || porNome(a.nome, b.nome); });
    /* icone da categoria, escolhido pelo nome (sem acento); categorias novas caem no generico */
    function iconeDa(cat) {
      var n = String(cat).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      if (/gas|energia|combust/.test(n)) return 'flame';
      if (/imobili|construc|engenharia/.test(n)) return 'home';
      if (/transport|logistic|van|veicul|auto/.test(n)) return 'truck';
      if (/supermerc|mercado|aliment/.test(n)) return 'cart';
      if (/varejo|comerc|loja|moda/.test(n)) return 'bag';
      return 'briefcase';
    }
  %>
  <%- include('partials/header', { base: '/' }) %>

  <main class="section partners-page">
    <div class="container">
      <header class="section__head section__head--center">
        <h1 class="title"><%= c.parceiras.titulo %></h1>
        <% if (c.parceiras.texto) { %><p class="lead"><%= c.parceiras.texto %></p><% } %>
      </header>

      <% if (destaques.length) { %>
        <section class="featured" aria-labelledby="destaquesTitulo">
          <div class="featured__head">
            <h2 class="featured__title" id="destaquesTitulo"><%- include('partials/icon', { name: 'star', cls: 'featured__star' }) %>Empresas em Destaque</h2>
            <span class="featured__tag"><%- include('partials/icon', { name: 'trend', cls: 'featured__tagicon' }) %>Maiores pagadoras da nossa rede</span>
          </div>
          <div class="fslider" id="destaques" role="region" aria-roledescription="carrossel" aria-label="Empresas em destaque">
            <div class="fslider__viewport">
              <ul class="fslider__track" tabindex="0" aria-label="Empresas em destaque (use as setas do teclado)">
                <% destaques.forEach(function (p, i) { var hasLink = p.link && p.link !== '#'; %>
                  <li class="fslide" role="group" aria-roledescription="slide" aria-label="<%= (i + 1) %> de <%= destaques.length %>">
                    <a class="fcard<%= hasLink ? '' : ' fcard--nolink' %>"<% if (hasLink) { %> href="<%= p.link %>" target="_blank" rel="noopener"<% } %> title="<%= p.nome %>" draggable="false">
                      <span class="fcard__crown"><%- include('partials/icon', { name: 'crown', cls: '' }) %></span>
                      <span class="pitem__logo">
                        <% if (p.logo) { %>
                          <% var fSrcset = srcset(p.logo); %>
                          <img src="<%= p.logo %>" alt="<%= p.nome %>" draggable="false"
                               <% if (fSrcset) { %>srcset="<%= fSrcset %>" sizes="(max-width: 560px) 80vw, 340px"<% } %> />
                        <% } else { %>
                          <span class="pitem__fallback"><%= p.nome %></span>
                        <% } %>
                      </span>
                      <span class="fcard__info">
                        <span class="fcard__name"><%= p.nome %></span>
                        <span class="fcard__badge"><%- include('partials/icon', { name: 'star', cls: '' }) %>Top Pagador</span>
                      </span>
                    </a>
                  </li>
                <% }); %>
              </ul>
            </div>
            <button type="button" class="fslider__btn fslider__btn--prev" aria-label="Empresa anterior" data-fprev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
            <button type="button" class="fslider__btn fslider__btn--next" aria-label="Próxima empresa" data-fnext><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
            <div class="fslider__dots" data-fdots aria-hidden="true"></div>
          </div>
        </section>
      <% } %>

      <% if (cats.length) { %>
        <% if (destaques.length) { %><h2 class="featured__title featured__title--all"><%- include('partials/icon', { name: 'handshake', cls: 'featured__star' }) %>Todas as Empresas</h2><% } %>
        <div class="pfilters" role="group" aria-label="Filtrar por categoria">
          <button type="button" class="pfilter is-active" data-cat="" aria-pressed="true">Todas</button>
          <% cats.forEach(function (cat) { %><button type="button" class="pfilter" data-cat="<%= cat %>" aria-pressed="false"><%= rotulos[cat] %></button><% }); %>
        </div>

        <div class="plist" id="plist">
          <% todas.forEach(function (p) {
               var hasLink = p.link && p.link !== '#'; %>
            <a class="pitem<%= hasLink ? '' : ' pitem--nolink' %>" data-cat="<%= p.cat %>"<% if (hasLink) { %> href="<%= p.link %>" target="_blank" rel="noopener"<% } %> title="<%= p.nome %>">
              <span class="pitem__logo">
                <% if (p.logo) { %>
                  <% var pSrcset = srcset(p.logo); %>
                  <img src="<%= p.logo %>" alt="<%= p.nome %>" loading="lazy"
                       <% if (pSrcset) { %>srcset="<%= pSrcset %>" sizes="(max-width: 560px) 80vw, 300px"<% } %>
                       />
                <% } else { %>
                  <span class="pitem__fallback"><%= p.nome %></span>
                <% } %>
              </span>
              <span class="pitem__name"><%= p.nome %></span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="lead">Em breve apresentaremos nossas empresas parceiras.</p>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    (function () {
      var botoes = document.querySelectorAll('.pfilter');
      var itens = document.querySelectorAll('.pitem');

      /* Ajuste automatico das logos: mede onde esta o desenho (ignorando o branco e a
         transparencia em volta) e enquadra so essa parte na caixa. Assim nenhuma logo
         e cortada, e as que vem com margem grande ficam do mesmo tamanho das demais.
         Se o navegador nao deixar ler os pixels, a logo continua inteira (CSS puro). */
      function aplica(img) {
        var b = img.dataset.bbox; if (!b) return;
        var box = img.parentNode, W = box.clientWidth, H = box.clientHeight;
        if (!W || !H) return;
        var v = b.split(',').map(Number), cw = v[2] - v[0], ch = v[3] - v[1];
        var nw = img.naturalWidth, nh = img.naturalHeight;
        var iw = Math.min((W * 0.86) / cw, (H * 0.86) / ch * (nw / nh)), ih = iw * nh / nw;
        img.style.width = iw + 'px'; img.style.height = ih + 'px';
        img.style.left = (W / 2 - (v[0] + v[2]) / 2 * iw) + 'px';
        img.style.top = (H / 2 - (v[1] + v[3]) / 2 * ih) + 'px';
        img.classList.add('is-fit');
      }
      function mede(img) {
        var probe = new Image();
        probe.crossOrigin = 'anonymous';
        probe.onload = function () {
          try {
            var f = Math.min(1, 300 / Math.max(probe.naturalWidth, probe.naturalHeight));
            var w = Math.max(1, Math.round(probe.naturalWidth * f)), h = Math.max(1, Math.round(probe.naturalHeight * f));
            var c = document.createElement('canvas'); c.width = w; c.height = h;
            var ctx = c.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(probe, 0, 0, w, h);
            var d = ctx.getImageData(0, 0, w, h).data, x0 = w, y0 = h, x1 = -1, y1 = -1;
            for (var y = 0; y < h; y++) for (var x = 0; x < w; x++) {
              var i = (y * w + x) * 4;
              if (d[i + 3] < 25 || (d[i] > 240 && d[i + 1] > 240 && d[i + 2] > 240)) continue;
              if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y;
            }
            if (x1 < 0) return;
            img.dataset.bbox = [x0 / w, y0 / h, (x1 + 1) / w, (y1 + 1) / h].join(',');
            aplica(img);
          } catch (e) { /* imagem de outra origem sem permissao: fica o ajuste por CSS */ }
        };
        probe.src = img.getAttribute('src');
      }
      var logos = [].slice.call(document.querySelectorAll('.pitem__logo img'));
      function refaz() { logos.forEach(aplica); }
      logos.forEach(function (img) { if (img.complete) mede(img); else img.addEventListener('load', function () { mede(img); }); });
      window.addEventListener('resize', refaz);

      /* Filtro animado (FLIP): so usa transform e opacity, que rodam na GPU e nao
         travam nem no celular. Quem sai some suave; quem fica desliza para o novo lugar;
         quem entra aparece subindo. Sem animacao se o aparelho pedir movimento reduzido. */
      var reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var suave = !reduz && typeof Element.prototype.animate === 'function';
      var atual = '', espera = null;
      var EASE = 'cubic-bezier(.2, .8, .2, 1)';

      function troca(cat) {
        var antes = new Map();
        itens.forEach(function (it) { if (!it.hidden) antes.set(it, it.getBoundingClientRect()); });
        itens.forEach(function (it) { it.hidden = !!cat && it.dataset.cat !== cat; });
        refaz();
        if (!suave) return;
        var n = 0;
        itens.forEach(function (it) {
          if (it.hidden) return;
          var r = it.getBoundingClientRect(), o = antes.get(it);
          if (o) {
            var dx = o.left - r.left, dy = o.top - r.top;
            if (!dx && !dy) return;
            it.animate([{ transform: 'translate(' + dx + 'px,' + dy + 'px)' }, { transform: 'none' }], { duration: 420, easing: EASE });
          } else {
            it.animate([{ opacity: 0, transform: 'translateY(14px) scale(.96)' }, { opacity: 1, transform: 'none' }],
              { duration: 380, delay: Math.min(n++, 8) * 30, easing: EASE, fill: 'backwards' });
          }
        });
      }

      function filtra(cat) {
        if (cat === atual) return;
        atual = cat;
        clearTimeout(espera);
        itens.forEach(function (it) { it.getAnimations().forEach(function (an) { an.cancel(); }); });
        if (!suave) { troca(cat); return; }
        var saem = [].filter.call(itens, function (it) { return !it.hidden && !!cat && it.dataset.cat !== cat; });
        saem.forEach(function (it) { it.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(.96)' }], { duration: 150, easing: 'ease-out', fill: 'forwards' }); });
        espera = setTimeout(function () { itens.forEach(function (it) { it.getAnimations().forEach(function (an) { an.cancel(); }); }); troca(cat); }, saem.length ? 150 : 0);
      }

      /* carrossel de destaques: scroll-snap nativo (toque, sem barra de rolagem) + setas e pontos.
         No desktop o card do meio ganha destaque; com poucas empresas elas ficam centralizadas. */
      (function () {
        var box = document.getElementById('destaques'); if (!box) return;
        var track = box.querySelector('.fslider__track'), slides = [].slice.call(track.children);
        var prev = box.querySelector('[data-fprev]'), next = box.querySelector('[data-fnext]'), dotsBox = box.querySelector('[data-fdots]');
        var dots = [], reduzMov = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var cs = function () { return getComputedStyle(box); };
        var porTela = function () { return parseInt(cs().getPropertyValue('--per'), 10) || 1; };
        var centrado = function () { return cs().getPropertyValue('--centered').trim() === '1'; };
        var destaca = function () { return cs().getPropertyValue('--emphasis').trim() === '1'; };
        var estatico = function () { return slides.length <= porTela(); };
        var passo = function () { return slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : 1; };

        function alvo(i) {
          var s = slides[i]; if (!s) return 0;
          return s.offsetLeft - (centrado() ? (track.clientWidth - s.offsetWidth) / 2 : 0);
        }
        function indice() {
          if (!centrado()) return Math.max(0, Math.min(slides.length - porTela(), Math.round(track.scrollLeft / passo())));
          var meio = track.scrollLeft + track.clientWidth / 2, melhor = 0, d = Infinity;
          slides.forEach(function (s, i) { var dd = Math.abs(s.offsetLeft + s.offsetWidth / 2 - meio); if (dd < d) { d = dd; melhor = i; } });
          return melhor;
        }
        function vaPara(i) {
          var max = centrado() ? slides.length - 1 : slides.length - porTela();
          i = Math.max(0, Math.min(max, i));
          track.scrollTo({ left: alvo(i), behavior: reduzMov ? 'auto' : 'smooth' });
        }
        function pontos() {
          var n = estatico() ? 0 : (centrado() ? slides.length : slides.length - porTela() + 1);
          if (n === dots.length) return;
          dotsBox.innerHTML = ''; dots = [];
          for (var k = 0; k < n; k++) { var d = document.createElement('span'); d.className = 'fslider__dot'; dotsBox.appendChild(d); dots.push(d); }
        }
        function atualiza() {
          var est = estatico(), i = -1;
          box.classList.toggle('is-static', est);
          pontos();
          if (!est) {
            var fim = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
            i = fim && !centrado() ? dots.length - 1 : indice();
            prev.disabled = track.scrollLeft <= 2; next.disabled = fim;
          }
          dots.forEach(function (d, k) { d.classList.toggle('is-active', k === i); });
          var marca = est ? (slides.length % 2 ? (slides.length - 1) / 2 : -1) : (centrado() ? i : indice() + Math.floor(porTela() / 2));
          slides.forEach(function (s, k) { s.classList.toggle('is-center', destaca() && k === marca); });
        }
        prev.addEventListener('click', function () { vaPara(indice() - 1); });
        next.addEventListener('click', function () { vaPara(indice() + 1); });
        track.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight') { e.preventDefault(); vaPara(indice() + 1); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); vaPara(indice() - 1); }
        });
        var ag = false;
        track.addEventListener('scroll', function () { if (ag) return; ag = true; requestAnimationFrame(function () { ag = false; atualiza(); }); }, { passive: true });
        window.addEventListener('resize', atualiza);
        atualiza();
      })();

      botoes.forEach(function (b) {
        b.addEventListener('click', function () {
          botoes.forEach(function (x) { x.classList.toggle('is-active', x === b); x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
          filtra(b.dataset.cat || '');
        });
      });
    })();
  </script>
</body>
</html>
