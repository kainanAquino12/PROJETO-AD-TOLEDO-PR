<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= c.parceiras.titulo %> — <%= c.site.nome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Mulish:wght@300;400;500;600&family=Lora:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%
    /* as empresas entram por categoria (campo "segmento") e em ordem alfabetica
       dentro dela, para nenhuma ganhar mais destaque que outra */
    var porNome = function (a, b) { return String(a).trim().localeCompare(String(b).trim(), 'pt-BR', { sensitivity: 'base' }); };
    var grupos = {};
    (c.parceiras.lista || []).forEach(function (p) {
      var cat = (p.segmento || '').trim() || 'Outras';
      (grupos[cat] = grupos[cat] || []).push(p);
    });
    var cats = Object.keys(grupos).sort(function (a, b) {
      if (a === 'Outras') return 1; if (b === 'Outras') return -1; return porNome(a, b);
    });
  %>
  <header class="header" id="header">
    <div class="container header__inner">
      <a href="/" class="brand" aria-label="<%= c.site.nome %>">
        <% if (c.site.logo) { %>
          <img src="<%= c.site.logo %>" alt="<%= c.site.nome %>" class="brand__img" />
        <% } else { %>
          <%- include('partials/logo', { cls: 'erlogo--nav', cidade: c.site.cidade }) %>
        <% } %>
      </a>
      <a href="/" class="btn btn--outline">← Voltar ao site</a>
    </div>
  </header>

  <section class="partners-section partners-page">
    <div class="container">
      <div class="pcrest" aria-hidden="true"><%- include('partials/icon', { name: 'handshake' }) %></div>
      <h1 class="section-title section-title--center"><%= c.parceiras.titulo %><span class="section-title__bar"></span></h1>
      <% if (c.parceiras.texto) { %><p class="partners-section__text"><%= c.parceiras.texto %></p><% } %>

      <% if (cats.length) { %>
        <div class="pfilters" role="tablist" aria-label="Categorias">
          <button type="button" class="pfilter is-active" data-cat="">Todas</button>
          <% cats.forEach(function (cat) { %><button type="button" class="pfilter" data-cat="<%= cat %>"><%= cat %></button><% }); %>
        </div>

        <% cats.forEach(function (cat) { %>
          <div class="pgroup" data-cat="<%= cat %>">
            <h2 class="pgroup__title"><%= cat %></h2>
            <div class="pgrid pgrid--compact">
              <% grupos[cat].sort(function (a, b) { return porNome(a.nome, b.nome); }).forEach(function (p) {
                   var hasLink = p.link && p.link !== '#'; %>
                <a class="pcard<%= hasLink ? '' : ' pcard--nolink' %>"<% if (hasLink) { %> href="<%= p.link %>" target="_blank" rel="noopener"<% } %> title="<%= p.nome %>">
                  <div class="pcard__logo">
                    <% if (p.logo) { %>
                      <% var pZoom = (Number(p.zoom) || 108) / 100, pSrcset = srcset(p.logo); %>
                      <img src="<%= p.logo %>" alt="<%= p.nome %>" loading="lazy"
                           <% if (pSrcset) { %>srcset="<%= pSrcset %>" sizes="(max-width: 560px) 92vw, 300px"<% } %>
                           style="--zoom: <%= pZoom %>" />
                    <% } else { %>
                      <span class="pcard__logo-fallback"><%= p.nome %></span>
                    <% } %>
                  </div>
                  <div class="pcard__body"><h3 class="pcard__name"><%= p.nome %></h3></div>
                </a>
              <% }); %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="ppage-empty">Em breve apresentaremos nossas empresas parceiras.</p>
      <% } %>
    </div>
  </section>

  <footer class="footer" id="rodape">
    <div class="container footer__inner">
      <div class="footer__text">
        <h2 class="footer__title"><%= c.footer.titulo %></h2>
        <p class="footer__subtitle"><%= c.footer.subtitulo %></p>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var botoes = document.querySelectorAll('.pfilter');
      var grupos = document.querySelectorAll('.pgroup');
      botoes.forEach(function (b) {
        b.addEventListener('click', function () {
          botoes.forEach(function (x) { x.classList.toggle('is-active', x === b); });
          grupos.forEach(function (g) { g.hidden = !!b.dataset.cat && g.dataset.cat !== b.dataset.cat; });
        });
      });
    })();
  </script>
</body>
</html>
